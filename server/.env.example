# Copy this file to .env if you want to change the defaults.
# `npm start` and `npm run dev` read the file named .env automatically.
PORT=3001
# Comma-separated list of website addresses allowed to connect
CLIENT_ORIGIN=http://localhost:5173

# Offline inbox limits (optional)
# How many messages are kept for one offline user
INBOX_MAX_PER_USER=200
# How many hours an undelivered message is kept before it is dropped
INBOX_TTL_HOURS=168

# MongoDB (optional). Without it the server keeps everything in memory only.
# Put your REAL value in server/.env, never in this example file and never on GitHub.
# Get the string in Atlas: Connect -> Drivers. Replace <db_password> with your password
# (symbols like @ : / in a password must be URL-encoded) and add the database name after .net/
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/chitchat?retryWrites=true&w=majority
# Database name override (optional; defaults to the one in the URI, else "chitchat")
# MONGODB_DB=chitchat
